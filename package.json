{
  "name": "s3-viewer",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "crd:generate": "bash scripts/generate-crd.sh",
    "watch": "pnpm --filter @s3-viewer/app watch",
    "lint": "turbo run lint",
    "operator": "pnpm --filter s3-viewer-operator watch",
    "up": "pnpm cluster:up && pnpm deploy",
    "down": "pnpm cluster:down",
    "cluster:up": "bash scripts/cluster-up.sh",
    "cluster:down": "bash scripts/cluster-down.sh",
    "test:integration": "bash scripts/ci-integration-test.sh",
    "deploy": "tilt up",
    "deploy:down": "tilt down",
    "check": "gitleaks dir -v && gitleaks git -v",
    "isReady": "pnpm build && pnpm lint && pnpm crd:generate && pnpm check"
  },
  "devDependencies": {
    "turbo": "2.10.11"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
