    "@nuxtjs/tailwindcss": "6.14.0",
    "nuxt": "4.4.8",
    "pretty-bytes": "7.1.0",
    "shikiji": "0.10.2",
    "timeago.js": "4.0.2",
    "ts-pattern": "5.9.0",
    "vue": "3.5.39",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@nuxt/hints": "1.1.3",
    "@types/node": "26.1.1",
    "eslint": "10.6.0",
    "eslint-config-tchoupinax": "2.6.0",
    "npm-check-updates": "22.2.9",
    "typescript": "6.0.3",
    "vite-plugin-eslint2": "5.3.0"
  },
  "packageManager": "pnpm@11.10.0"
