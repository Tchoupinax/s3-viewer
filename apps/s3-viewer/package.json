{
  "name": "@s3-viewer/app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "generate": "nuxt generate",
    "lint": "pnpm lint:eslint && pnpm lint:vue:check",
    "lint:eslint": "NODE_ENV=development nuxt prepare && eslint . --fix",
    "lint:vue:check": "vue-tsc --noEmit",
