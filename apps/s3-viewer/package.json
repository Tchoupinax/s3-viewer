    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxtjs/tailwindcss": "6.14.0",
    "nuxt": "4.5.2",
    "pretty-bytes": "7.1.1",
    "shikiji": "0.10.2",
    "timeago.js": "4.0.2",
    "ts-pattern": "5.9.0",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/hints": "1.1.4",
    "@types/node": "26.2.0",
    "eslint": "10.9.0",
    "eslint-config-tchoupinax": "2.6.1",
    "npm-check-updates": "23.0.2",
    "typescript": "^6.0.3",
    "vite-plugin-eslint2": "5.3.0",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@11.22.0"
